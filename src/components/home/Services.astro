---
const services = [
    {
        key: 'digital-uv-3d',
        title: 'Цифровая, УФ и 3D печать',
        description: 'Высококачественная печать любой сложности: цифровая, УФ-печать на любых материалах, 3D-печать и прототипирование.',
        icon: 'printer',
        colorText: '#68C9F3',
    },
    {
        key: 'milling-laser',
        title: 'Фрезеровка и лазерная резка',
        description: 'Прецизионная фрезеровка и лазерная резка листовых материалов. Гравировка на различных поверхностях.',
        icon: 'scissors',
        colorText: '#ED6F17',
    },
    {
        key: 'outdoor-ad',
        title: 'Изготовление наружной рекламы',
        description: 'Вывески, объемные буквы, баннеры, лайтбоксы, штендеры и оформление фасадов от проекта до монтажа.',
        icon: 'store',
        colorText: '#432483',
    },
    {
        key: 'interior-ad',
        title: 'Интерьерная реклама',
        description: 'Таблички, указатели, стенды, фотообои, холсты, постеры и оформление внутренних помещений.',
        icon: 'image',
        colorText: '#801D81',
    },
    {
        key: 'merch',
        title: 'Сувенирная продукция (мерч)',
        description: 'Брендирование футболок, кружек, ручек, фото зоны и сувенирная продукция под заказ для вашего бизнеса.',
        icon: 'shirt',
        colorText: '#432483',
    },
    {
        key: 'awards',
        title: 'Наградная продукция',
        description: 'Кубки, медали, статуэтки, дипломы, грамоты — изготовление наградной продукции любой сложности.',
        icon: 'trophy',
        colorText: '#801D81',
    },
];
---
<section id="services" class="py-24 bg-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2 class="text-4xl font-extrabold text-[#2B2A28] mb-4">Наши услуги</h2>
            <div class="w-20 h-1.5 gradient-bg mx-auto rounded-full"></div>
            <p class="mt-6 text-xl text-gray-600 max-w-2xl mx-auto">Комплексные решения для вашего бизнеса от профессионалов с собственным производством</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {services.map((service) => (
                <div class="service-card group p-8 rounded-3xl bg-gray-50 hover:bg-white hover:shadow-2xl border border-transparent hover:border-gray-100 relative overflow-hidden" style={`--service-shadow: ${service.colorText}1a;`}>
                    <div class="absolute top-0 right-0 w-24 h-24 opacity-5 rounded-bl-full transition-all group-hover:scale-150" style={`background-color: ${service.colorText};`}></div>
                    <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-6 transition-colors duration-300" style={`color: ${service.colorText}; background-color: ${service.colorText}1a;`}>
                        <i data-lucide={service.icon} class="w-7 h-7"></i>
                    </div>
                    <h3 class="text-xl font-bold mb-3 text-[#2B2A28]">{service.title}</h3>
                    <p class="text-sm text-gray-500 leading-relaxed mb-4">{service.description}</p>
                    <a href="#contacts-form" data-form-service={service.key} class="inline-flex items-center font-semibold text-sm hover:translate-x-1 transition-transform" style={`color: ${service.colorText};`}>
                        Подробнее <i data-lucide="chevron-right" class="w-4 h-4 ml-1"></i>
                    </a>
                </div>
            ))}
        </div>
    </div>
</section>
