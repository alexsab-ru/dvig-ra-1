---
const items = [
    { icon: 'clock', color: '#68C9F3', title: 'Соблюдение сроков', text: 'Мы ценим ваше время, поэтому всегда сдаем проекты точно в оговоренный срок.' },
    { icon: 'award', color: '#ED6F17', title: 'Высокое качество', text: 'Используем только лучшие материалы и современное оборудование.' },
    { icon: 'users', color: '#801D81', title: 'Команда профи', text: 'Дизайнеры, верстальщики и печатники с опытом работы более 5 лет.' },
    { icon: 'zap', color: '#95D4E7', title: 'Креативный подход', text: 'Не боимся смелых идей и нестандартных решений для вашего бизнеса.' },
];
---
<section class="py-20 bg-[#2B2A28] text-white relative overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
        <div class="absolute -right-20 -top-40 w-96 h-96 bg-[#801D81] rounded-full blur-[128px] opacity-40"></div>
        <div class="absolute -left-20 -bottom-40 w-96 h-96 bg-[#ED6F17] rounded-full blur-[128px] opacity-30"></div>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12 text-center md:text-left">
            {items.map((item) => (
                <div class="space-y-4">
                    <div class="w-12 h-12 mx-auto md:mx-0 rounded-xl flex items-center justify-center" style={`color: ${item.color}; background-color: ${item.color}33;`}>
                        <i data-lucide={item.icon} class="w-6 h-6"></i>
                    </div>
                    <h3 class="text-xl font-bold">{item.title}</h3>
                    <p class="text-gray-400 text-sm">{item.text}</p>
                </div>
            ))}
        </div>
    </div>
</section>
