<header class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden bg-gray-50">
    <div class="absolute top-0 right-0 -mr-20 -mt-20 w-[800px] h-[800px] rounded-full bg-[#95D4E7] opacity-40 blur-[100px]"></div>
    <div class="absolute bottom-0 left-0 -ml-40 -mb-20 w-[600px] h-[600px] rounded-full bg-[#462483] opacity-30 blur-[120px]"></div>
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[1000px] h-[1000px] bg-white opacity-40 blur-3xl rounded-full"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <div class="space-y-8 animate-fade-in-up">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-gray-200 shadow-sm text-sm font-semibold text-[#801D81]">
                    <span class="w-2 h-2 rounded-full bg-[#ED6F17]"></span>
                    Работаем с 2008 года
                </div>
                <h1 class="text-5xl lg:text-7xl font-extrabold leading-tight text-[#2B2A28]">
                    Придаем <span class="gradient-text">динамику</span> вашему бренду
                </h1>
                <p class="text-xl text-gray-600 max-w-lg leading-relaxed">
                    Под ключ решаем задачи любого масштаба: производство, полиграфия, сувенирная продукция, дизайн и PR-сопровождение.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 pt-4">
                    <a href="#contacts-form" data-form-service="calculate-project" class="px-8 py-4 rounded-xl gradient-bg text-white font-bold text-lg hover:shadow-xl hover:shadow-[#ED6F17]/30 transition-all transform hover:-translate-y-1 flex items-center justify-center gap-2 text-center">
                        Рассчитать проект
                    </a>
                    <button class="hidden px-8 py-4 rounded-xl bg-white border-2 border-gray-100 text-[#432483] font-bold text-lg hover:border-[#432483] hover:bg-gray-50 transition-all flex items-center justify-center gap-2">
                        <i data-lucide="download" class="w-5 h-5"></i>
                        Презентация
                    </button>
                </div>
                <div class="flex items-center justify-center lg:justify-start gap-4 sm:gap-8 pt-8 border-t border-gray-200/50">
                    <div>
                        <p class="text-2xl sm:text-3xl font-bold text-[#2B2A28]">18+</p>
                        <p class="text-sm text-gray-500 font-medium">Лет на рынке</p>
                    </div>
                    <div class="w-px h-10 bg-gray-300"></div>
                    <div>
                        <p class="text-2xl sm:text-3xl font-bold text-[#2B2A28]">500+</p>
                        <p class="text-sm text-gray-500 font-medium">Клиентов</p>
                    </div>
                    <div class="w-px h-10 bg-gray-300"></div>
                    <div>
                        <p class="text-2xl sm:text-3xl font-bold text-[#2B2A28]">1 команда</p>
                        <p class="text-sm text-gray-500 font-medium">Весь проект под ключ</p>
                    </div>
                </div>
            </div>
            <div class="relative lg:h-[600px] flex items-center justify-center">
                <div class="absolute inset-0 bg-gradient-to-tr from-[#ED6F17] via-[#801D81] to-[#68C9F3] rounded-[3rem] transform rotate-6 opacity-10 blur-xl"></div>
                <div class="relative w-full h-full min-h-80 rounded-[2rem] overflow-hidden shadow-2xl group">
                    <img src="/images/portfolio/dvig-ra-1x1.jpg" alt="Production Process" class="w-full h-full min-h-80 object-cover transition-transform duration-700 group-hover:scale-105" />
                    <div class="absolute inset-0 bg-gradient-to-t from-[#432483]/80 via-transparent to-transparent"></div>
                    <div class="absolute top-8 left-8 right-8 text-white">
                        <div class="flex items-center gap-3 mb-2">
                            <div class="p-2 bg-[#ED6F17] rounded-lg">
                                <i data-lucide="printer" class="w-6 h-6 text-white"></i>
                            </div>
                            <span class="font-bold text-lg">Собственное производство</span>
                        </div>
                        <p class="text-white/80 text-sm">Контроль качества на каждом этапе изготовления продукции</p>
                    </div>
                </div>

                <div class="absolute -bottom-6 -left-3 md:-left-5 bg-white p-6 rounded-2xl shadow-xl max-w-xs animate-bounce" style="animation-duration: 3s;">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center text-green-600">
                            <i data-lucide="check-circle" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <p class="font-bold text-[#2B2A28]">Заказ готов</p>
                            <p class="text-xs text-gray-500">Ваш тираж отпечатан и готов к отгрузке</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>
