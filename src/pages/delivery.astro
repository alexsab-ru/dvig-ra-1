---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Delivery from '../components/delivery/Delivery.astro';
import ContactsSection from '../components/ContactsSection.astro';
---
<BaseLayout
    title="Доставка и оплата — РПФ Движение"
    description="Условия доставки и оплаты заказов РПФ «Движение» по Краснодару, Адыгее, Краснодарскому краю и всей России."
    canonical="https://dvig-ra.ru/delivery/"
>
    <PageHero eyebrow="Условия работы" title="Доставка и оплата" description="Рассказываем, как можно оплатить заказ и получить готовую рекламную продукцию в Краснодаре, Адыгее, по краю и в других регионах России." />
    <Delivery showHeader={false} />
    <ContactsSection />
</BaseLayout>
